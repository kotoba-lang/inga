;; inga — 因果. The consensus plane of the kotoba stack (ADR-2608038000).
;;
;; `src/inga/head.cljk` and `src/inga/ref.cljk` are pure `.cljc`: no I/O, no
;; crypto, no wall-clock. Signature verification and the quorum itself are
;; INJECTED, the same seam `kotobase.storage.signed-head` uses for `sign-fn`
;; and `engi.consensus` uses for `hash-fn`. That is what keeps the curve at
;; the edge (Workers already have @noble/curves) and this library portable.
;;
;; ## The runtime dependency set, and why it is closed
;;
;; This block used to say "the only dependency is the storage CONTRACT it
;; implements", which stopped being true one line below it when `arrangement`
;; arrived for F1 — and arrangement is not zero-dependency either (datalog,
;; datom-source, io-ipld, prolly-tree, io-multiformats, org-ietf-cbor all come
;; with it; `shadow-cljs.edn`'s generated source paths list them). So the
;; posture is not "zero dependencies" and pretending otherwise would make the
;; real rule unstateable. The real rule is narrower and it is about consensus:
;;
;;   **Nothing on which two replicas could disagree may enter this set.**
;;
;; Both entries pass. They are content-addressed data structures and a storage
;; contract: given the same bytes they produce the same bytes, and a replica
;; running a different pin of them produces a visibly different CID rather than
;; a quietly different ANSWER.
;;
;; The thing this rule excludes is named because it was measured and declined,
;; not because nobody thought of it: an INTERPRETER for the decision cores in
;; `kotoba/`. See `test/inga/kotoba_reproducibility_test.cljk` for the numbers
;; and `README.md` ("What the Kotoba cores actually run") for the argument.
;; `kotoba-kir` therefore does not appear here, and a test asserts it stays out.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error {:git/sha "838dec56c9a5b74f9eec825a2fb28bda157f8cd3"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/kotobase-storage
        {:git/url "https://github.com/kotoba-lang/kotobase-storage.git"
         :git/sha "f41e7bd3dfc8547614c6adc843c9d5fd1290687f"}
        ;; F1: the content-addressed state root. arrangement already snapshots a
        ;; 4-index datom db into prolly-trees, CID-addresses the commit, restores
        ;; from it, and queries it with Datalog. inga wires it to the machine seam
        ;; and adds the :cid vs :opaque distinction -- it does not reimplement any
        ;; of that (ADR-2608038000 F1 explicitly declines to introduce a HAMT).
        io.github.kotoba-lang/arrangement
        {:git/url "https://github.com/kotoba-lang/arrangement.git"
         :git/sha "096523fb2d57b57d89da88a47c07e6bc008c2285"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; The compiler that BUILT `kotoba/*.wasm`, here and only
                      ;; here. It is the producer, and a producer that can reach
                      ;; a consumer is a consumer: nothing under `src/` may load
                      ;; it, and nothing does.
                      ;;
                      ;; Pinned by inga rather than tracked from the fleet on
                      ;; purpose. `kotoba-reproducibility-test` recompiles the
                      ;; sources with THIS compiler and requires the bytes to
                      ;; equal the checked-in binaries, so the pin is the
                      ;; question the gate asks. Tracking the fleet pin would
                      ;; turn it red every time somebody else advanced the
                      ;; compiler — which is the objection ADR-2608120200 raises
                      ;; against recompile gates in general, and it is avoided by
                      ;; owning the pin, not by skipping the gate.
                      ;;
                      ;; Moving it is a real piece of work and not a version
                      ;; bump: measured on `kotoba-lang/kura` 2026-08-12, the
                      ;; compiler on `main` rejects sources these pins accept
                      ;; (`string=?` returns `:bool` there and `:i64` here), so
                      ;; advancing means migrating the cores and regenerating.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "806f5cef7d5bc11ad8ec8514ad6121efc73be6c7"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; Rebuild `kotoba/*.wasm` and their provenance records from `kotoba/*.kotoba`.
  ;; Combine with :test, which is where the compiler lives:
  ;;
  ;;   kbb -M:test:gen
  :gen {:main-opts ["-m" "inga.kotoba-wasm-gen"]}
  ;; One scenario, both runtimes, one digest. See inga.parity's docstring:
  ;; a JVM suite is not evidence about ClojureScript, and ClojureScript is
  ;; the runtime kotobase actually deploys on.
  :parity {:main-opts ["-m" "inga.parity"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
