;; inga — 因果. The consensus plane of the kotoba stack (ADR-2608038000).
;;
;; `src/inga/head.cljc` and `src/inga/ref.cljc` are pure `.cljc`: no I/O, no
;; crypto, no wall-clock. Signature verification and the quorum itself are
;; INJECTED, the same seam `kotobase.storage.signed-head` uses for `sign-fn`
;; and `engi.consensus` uses for `hash-fn`. That is what keeps the curve at
;; the edge (Workers already have @noble/curves) and this library portable.
;;
;; The only dependency is the storage CONTRACT it implements. kotobase-storage
;; is itself zero-dependency, so nothing transitive arrives with it.
{:paths ["src"]
 :deps {io.github.kotoba-lang/kotobase-storage
        {:git/url "https://github.com/kotoba-lang/kotobase-storage.git"
         :git/sha "f41e7bd3dfc8547614c6adc843c9d5fd1290687f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
