(ns inga.native-replica-gate
 (:require [inga.native-prefix :as p] [inga.native-live-test-keys :as keys] [inga.native-view-change :as v]
           [inga.native-live-context :as c] [inga.native-wire :as w]
           [inga.native-replica :as r] [ed25519.selfhost :as ed])
 (:export [main]))
(defn- context [index :i64] :string (keys/context index))
(defn- seed [index :i64] :vector-i64 (keys/seed index))
(defn- vote [ctx :string block :string index :i64] :string
 (let [key (p/field (keys/validators) 44 index)
       sig (w/hex (ed/sign (seed index) (w/bytes (p/live-vote-payload (c/chain ctx) block key))))]
  (w/join key "," (w/join (p/field block 124 5) "," sig))))
(defn main [] :i64
 (let [ctx (context 1) peer (context 0) initial (r/initial ctx)
       proposal (r/prepare ctx initial "propose|bafkreipublicrequest")
       state (record-get [:ref :inga.native/candidate] proposal :state)
       prefix (w/text (r/value state 11)) block (p/field prefix 10 1)
       signature (w/hex (ed/sign (seed 1) (w/bytes (p/live-proposal-payload (c/chain ctx) block))))
       received (r/prepare peer (r/initial peer) (w/join "proposal" "|" (w/join (w/ascii-hex prefix) "|" signature)))
       first (r/prepare ctx state (w/join "vote" "|" (vote ctx block 0)))
       first-state (record-get [:ref :inga.native/candidate] first :state)
       duplicate (r/prepare ctx first-state (w/join "vote" "|" (vote ctx block 0)))
       second (r/prepare ctx first-state (w/join "vote" "|" (vote ctx block 1)))
       third (r/prepare ctx (record-get [:ref :inga.native/candidate] second :state) (w/join "vote" "|" (vote ctx block 2)))
       certified (record-get [:ref :inga.native/candidate] third :state)
       prefix0 (c/genesis ctx) qc0 (w/join "0" ":" (string-concat (c/anchor ctx) ":"))
       nv0 (v/signed-message (context 0) (seed 0) 1 prefix0 qc0)
       nv1 (v/signed-message ctx (seed 1) 1 prefix0 qc0)
       nv2 (v/signed-message (context 2) (seed 2) 1 prefix0 qc0)
       nv-first (r/prepare ctx initial (w/join "new-view" "|" nv0))
       nv-state (record-get [:ref :inga.native/candidate] nv-first :state)
       nv-second (r/prepare ctx nv-state (w/join "new-view" "|" nv1))
       timeout (r/prepare ctx (record-get [:ref :inga.native/candidate] nv-second :state) (w/join "new-view" "|" nv2))
       timeout-state (record-get [:ref :inga.native/candidate] timeout :state)
       dup-set (w/join nv0 ";" (w/join nv0 ";" nv1))
       valid-set (w/join nv0 ";" (w/join nv1 ";" nv2))]

  (+ (if (c/valid? ctx) 1 0) (if (c/key-matches? ctx (seed 1)) 1 0)
     (if (not (c/key-matches? ctx (seed 0))) 1 0)
     (if (= (c/chain ctx) (c/chain peer)) 1 0)
     (if (r/valid-state? ctx initial) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] proposal :status) 1) 1 0)
     (if (r/valid-state? ctx state) 1 0)
     (if (= (r/num state 8) 1) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] (r/prepare ctx state "propose|other") :status) 0) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] (r/prepare ctx state "propose|bafkreipublicrequest") :state) state) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] received :status) 1) 1 0)
     (if (r/valid-state? peer (record-get [:ref :inga.native/candidate] received :state)) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] first :kind) 4) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] duplicate :state) first-state) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] second :kind) 4) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] third :kind) 3) 1 0)
     (if (= (r/num certified 0) 2) 1 0)
     (if (r/valid-state? ctx certified) 1 0)
     (if (w/ascii-hex? "007f0a") 1 0)
     (if (not (w/ascii-hex? "80")) 1 0)
     (if (v/valid-message? ctx nv0) 1 0)
     (if (not (v/certificate? ctx dup-set)) 1 0)
     (if (v/certificate? ctx valid-set) 1 0)
     (if (r/valid-state? ctx nv-state) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] (r/prepare ctx nv-state (w/join "new-view" "|" nv0)) :state) nv-state) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] timeout :kind) 6) 1 0)
     (if (= (r/num timeout-state 0) 2) 1 0)
     (if (r/valid-state? ctx timeout-state) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] (r/prepare ctx initial (w/join "tc" "|" (w/ascii-hex dup-set))) :status) 0) 1 0)
     (if (= (record-get [:ref :inga.native/candidate] (r/prepare ctx initial (w/join "tc" "|" (w/ascii-hex valid-set))) :state) timeout-state) 1 0))))
